  "recommendation_suffix": "",
  "comment_style_preset": "community",
  "secret_comment": false,
  "browser_mode": "persistent",
  "direct_urls": [],
  "pacing_enabled": true,
  "page_settle_min": 1.0,
  "page_settle_max": 2.0,
  "pre_like_delay_min": 1.0,
  "pre_like_delay_max": 2.5,
  "post_like_delay_min": 1.0,
  "post_like_delay_max": 2.5,
  "action_delay_min": 1.0,

  "max_feed_items": 20,
  "like_enabled": true,
  "comment_enabled": true,
  "comment_template": "{비쥬얼이 참 좋네요|너무 좋아 보여요|보기만 해도 기분 좋아지는 글이네요}~",
  "general_suffix": "",
  "fixed_suffix": "",
